    "intentTestQueries": {
        "check_balance": {
            "testQuery": "What's my account balance?",
            "expectedBehaviorWhenEnabled": "SHOULD_HANDLE_NORMALLY",
            "expectedBehaviorWhenDisabled": "SHOULD_EXPLAIN_UNAVAILABLE",
            "keywords": [
                "balance",
                "account"
            ]
        },
        "transfer_funds": {
            "testQuery": "I want to transfer money",
            "expectedBehaviorWhenEnabled": "SHOULD_HANDLE_NORMALLY",
            "expectedBehaviorWhenDisabled": "SHOULD_EXPLAIN_UNAVAILABLE",
            "keywords": [
                "transfer",
                "money"
            ]
        },
        "change_pin": {
            "testQuery": "I need to change my PIN",
            "expectedBehaviorWhenEnabled": "SHOULD_HANDLE_NORMALLY",
            "expectedBehaviorWhenDisabled": "SHOULD_EXPLAIN_UNAVAILABLE",
            "keywords": [
