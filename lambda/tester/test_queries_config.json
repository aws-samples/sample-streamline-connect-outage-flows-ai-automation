    "behaviorCategories": {
        "SHOULD_EXPLAIN_UNAVAILABLE": {
            "description": "Agent should explain that the service is temporarily unavailable",
            "requiredKeywords": [
                "unavailable",
                "temporarily",
                "currently",
                "apologize",
                "not available"
            ],
            "minimumMatches": 1
        },
        "SHOULD_HANDLE_NORMALLY": {
            "description": "Agent should handle the request normally without mentioning unavailability",
            "forbiddenKeywords": [
                "unavailable",
                "currently unavailable",
                "apologize",
                "temporarily"
            ],
            "requiresResponse": true
        },
        "SHOULD_OFFER_ALTERNATIVE": {
            "description": "Agent should suggest alternative services or actions",
            "requiredKeywords": [
                "available",
                "can",
                "help",
                "alternative",
                "service",
                "offer"
            ],
            "minimumMatches": 1
        }
    }
